	prefix := path + "."
	for candidate := range allowed {
		if strings.HasPrefix(candidate, prefix) {
			return true
		}
	}
	for candidate := range fieldTypes {
		if strings.HasPrefix(candidate, prefix) {
			return true
		}
	}
	return false
}


// Package bootstrap wires the goa-ai runtime and registers generated agents.
// Goa creates this file only when it does not already exist. The application
// owns all later edits.
package bootstrap

import (
	"context"
	"flag"

	scribe "goa.design/goa-ai/gen/alpha/agents/scribe"
	first "goa.design/goa-ai/gen/alpha/agents/scribe/first"
	second "goa.design/goa-ai/gen/alpha/agents/scribe/second"
	first2 "goa.design/goa-ai/gen/calc_api/toolsets/first"
	second2 "goa.design/goa-ai/gen/calc_api2/toolsets/second"
	plannerscribe "goa.design/goa-ai/internal/agents/scribe/planner"
	"goa.design/goa-ai/runtime/agent/engine"
	agentsruntime "goa.design/goa-ai/runtime/agent/runtime"
	"goa.design/goa-ai/runtime/agent/storage"
	mcpruntime "goa.design/goa-ai/runtime/mcp"
)

// Define flags for MCP endpoints (if any). Pass values via your cmd main.
var (
	mcpCalcAPICoreEndpoint  = flag.String("mcp-calc-api-core-endpoint", "", "MCP first HTTP endpoint (e.g., http://127.0.0.1:8080/rpc)")
	mcpCalcAPICoreEndpoint2 = flag.String("mcp-calc_api-core-endpoint", "", "MCP second HTTP endpoint (e.g., http://127.0.0.1:8080/rpc)")
)

// New constructs a runtime with the host-owned store and registers all agents
// for this service. Replace the example planner and tool executors as you adopt
// production wiring.
func New(ctx context.Context, store storage.Store) (*agentsruntime.Runtime, func(), error) {
	rt := agentsruntime.New(store)
	cleanup := func() {}

	// Register each executable once. Agent definitions may share these bindings.
	{
		caller, err := mcpruntime.NewHTTPCaller(mcpruntime.HTTPOptions{
			Endpoint:   *mcpCalcAPICoreEndpoint,
			ClientInfo: mcpruntime.ClientInfo{Name: "alpha", Version: "0.0.1"},
		})
		if err != nil {
			return nil, nil, err
		}
		exec := first.NewMCPExecutor(caller)
		registration := agentsruntime.ToolsetRegistration{
			Name:                "first",
			ActivityRetryPolicy: &engine.RetryPolicy{MaxAttempts: 1},
			Specs:               first2.Specs(),
			ToolMetadataLookup:  first2.MetadataByName,
			Execute: func(ctx context.Context, call *agentsruntime.ToolCall) (*agentsruntime.ToolExecutionResult, error) {
				meta := agentsruntime.ToolCallMetaFromCall(*call)
				return exec.Execute(ctx, &meta, call)
			},
		}
		if err := rt.RegisterToolset(registration); err != nil {
			return nil, nil, err
		}
	}
	{
		caller, err := mcpruntime.NewHTTPCaller(mcpruntime.HTTPOptions{
			Endpoint:   *mcpCalcAPICoreEndpoint2,
			ClientInfo: mcpruntime.ClientInfo{Name: "alpha", Version: "0.0.1"},
		})
		if err != nil {
			return nil, nil, err
		}
		exec := second.NewMCPExecutor(caller)
		registration := agentsruntime.ToolsetRegistration{
			Name:                "second",
			ActivityRetryPolicy: &engine.RetryPolicy{MaxAttempts: 1},
			Specs:               second2.Specs(),
			ToolMetadataLookup:  second2.MetadataByName,
			Execute: func(ctx context.Context, call *agentsruntime.ToolCall) (*agentsruntime.ToolExecutionResult, error) {
				meta := agentsruntime.ToolCallMetaFromCall(*call)
				return exec.Execute(ctx, &meta, call)
			},
		}
		if err := rt.RegisterToolset(registration); err != nil {
			return nil, nil, err
		}
	}

	// Register agents with example planners. Replace with your own planner implementations.
	{
		cfg := scribe.ScribeAgentConfig{Planner: plannerscribe.New()}
		if err := scribe.RegisterScribeAgent(ctx, rt, cfg); err != nil {
			return nil, nil, err
		}
	}

	return rt, cleanup, nil
}

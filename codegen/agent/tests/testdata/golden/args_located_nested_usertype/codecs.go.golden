// decodedJSONType returns the JSON category retained by Decoder.UseNumber.
func decodedJSONType(value any) string {
	switch value.(type) {
	case bool:
		return "boolean"
	case json.Number:
		return "number"
	case string:
		return "string"
	case []any:
		return "array"
	case map[string]any:
		return "object"
	default:
		panic(fmt.Sprintf("unsupported decoded JSON value %T", value))
	}
}


// Helper transform functions
func decodeStatusChangedEventTransportToStatusChangedEvent(v *toolhttp.StatusChangedEventTransport) *types.StatusChangedEvent {
	res := &types.StatusChangedEvent{
		StepID: *v.StepID,
		Status: types.Status(*v.Status),
		Note:   v.Note,
	}
	switch string(v.State.Kind()) {
	case "active":
		actual, _ := v.State.AsActive()
		var obj *types.ActiveStatus
		if actual != nil {
			obj = decodeActiveStatusTransportToActiveStatus(actual)
		}
		u := res.State
		u.SetActive((*types.ActiveStatus)(obj))
		res.State = u
	case "inactive":
		actual, _ := v.State.AsInactive()
		var obj *types.InactiveStatus
		if actual != nil {
			obj = decodeInactiveStatusTransportToInactiveStatus(actual)
		}
		u := res.State
		u.SetInactive((*types.InactiveStatus)(obj))
		res.State = u
	case "since":
		actual, _ := v.State.AsSince()
		obj := types.StepStateBranchSince(actual)

		u := res.State
		u.SetSince((types.StepStateBranchSince)(obj))
		res.State = u
	}

	return res
}
func decodeActiveStatusTransportToActiveStatus(v *toolhttp.ActiveStatusTransport) *types.ActiveStatus {
	res := &types.ActiveStatus{
		Status: types.Status(*v.Status),
	}

	return res
}
func decodeInactiveStatusTransportToInactiveStatus(v *toolhttp.InactiveStatusTransport) *types.InactiveStatus {
	res := &types.InactiveStatus{}

	return res
}
func encodeStatusChangedEventToStatusChangedEventTransport(v *types.StatusChangedEvent) *toolhttp.StatusChangedEventTransport {
	res := &toolhttp.StatusChangedEventTransport{
		StepID: &v.StepID,
		Note:   v.Note,
	}
	status := toolhttp.StatusTransport(v.Status)
	res.Status = &status
	var stateValue toolhttp.StepState
	switch string(v.State.Kind()) {
	case "active":
		actual, _ := v.State.AsActive()
		var obj *toolhttp.ActiveStatusTransport
		if actual != nil {
			obj = encodeActiveStatusToActiveStatusTransport(actual)
		}
		u := stateValue
		u.SetActive((*toolhttp.ActiveStatusTransport)(obj))
		stateValue = u
	case "inactive":
		actual, _ := v.State.AsInactive()
		var obj *toolhttp.InactiveStatusTransport
		if actual != nil {
			obj = encodeInactiveStatusToInactiveStatusTransport(actual)
		}
		u := stateValue
		u.SetInactive((*toolhttp.InactiveStatusTransport)(obj))
		stateValue = u
	case "since":
		actual, _ := v.State.AsSince()
		obj := toolhttp.StepStateSinceTransport(actual)

		u := stateValue
		u.SetSince((toolhttp.StepStateSinceTransport)(obj))
		stateValue = u
	}
	res.State = &stateValue

	return res
}
func encodeActiveStatusToActiveStatusTransport(v *types.ActiveStatus) *toolhttp.ActiveStatusTransport {
	res := &toolhttp.ActiveStatusTransport{}
	status := toolhttp.StatusTransport(v.Status)
	res.Status = &status

	return res
}
func encodeInactiveStatusToInactiveStatusTransport(v *types.InactiveStatus) *toolhttp.InactiveStatusTransport {
	res := &toolhttp.InactiveStatusTransport{}

	return res
}

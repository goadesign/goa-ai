// validateSearchResultJSONValue checks one value whose JSON shape is fixed by the generated Goa type.
func validateSearchResultJSONValue(path string, value any, description string) error {
	field := path
	if field == "" {
		field = "$payload"
	}
	if value == nil {
		return invalidGeneratedFieldTypeError(field, "object", "null", description)
	}
	typed, ok := value.(map[string]any)
	if !ok {
		return invalidGeneratedFieldTypeError(field, "object", decodedJSONType(value), description)
	}
	keys := make([]string, 0, len(typed))
	for key := range typed {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	for _, key := range keys {
		switch key {
		case "next_cursor":
			if err := validateStringJSONValue(
				generatedJSONChildPath(path, key, false),
				typed[key], "Continuation reference for the next page.",
			); err != nil {
				return err
			}
		case "refinement_hint":
			if err := validateStringJSONValue(
				generatedJSONChildPath(path, key, false),
				typed[key], "Short guidance on how to narrow the request when the result is truncated.",
			); err != nil {
				return err
			}
		case "results":
			if err := validateSearchResultRootResultsJSONValue(
				generatedJSONChildPath(path, key, false),
				typed[key], "Results",
			); err != nil {
				return err
			}
		case "returned":
			if err := validateIntJSONValue(
				generatedJSONChildPath(path, key, false),
				typed[key], "Number of items returned in this response after applying tool limits.",
			); err != nil {
				return err
			}
		case "total":
			if err := validateIntJSONValue(
				generatedJSONChildPath(path, key, false),
				typed[key], "Total number of matching items before truncation.",
			); err != nil {
				return err
			}
		case "truncated":
			if err := validateBooleanJSONValue(
				generatedJSONChildPath(path, key, false),
				typed[key], "True when this result is partial because tool limits or caps were applied.",
			); err != nil {
				return err
			}
		default:
			return unknownJSONFieldError(path, key, []string{
				"next_cursor",
				"refinement_hint",
				"results",
				"returned",
				"total",
				"truncated",
			})
		}
	}
	return nil
}


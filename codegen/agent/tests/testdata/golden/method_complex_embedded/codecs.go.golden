	case bool:
		return "boolean"
	case json.Number:
		return "number"
	case string:
		return "string"
	case []any:
		return "array"
	case map[string]any:
		return "object"
	default:
		panic(fmt.Sprintf("unsupported decoded JSON value %T", value))
	}
}

// generatedUnmarshalJSONType reduces encoding/json's detailed value label to

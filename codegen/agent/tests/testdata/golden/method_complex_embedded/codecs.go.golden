// Helper transform functions
func decodeProfileTransportToProfile(v *toolhttp.ProfileTransport) *Profile {
	res := &Profile{
		ID:   *v.ID,
		Name: v.Name,
	}
	res.Address = decodeAddressTransportToAddress(v.Address)

	return res
}
func decodeAddressTransportToAddress(v *toolhttp.AddressTransport) *Address {
	res := &Address{
		Street: *v.Street,
		City:   *v.City,
	}

	return res
}
func encodeProfileToProfileTransport(v *Profile) *toolhttp.ProfileTransport {
	res := &toolhttp.ProfileTransport{
		ID:   &v.ID,
		Name: v.Name,
	}
	res.Address = encodeAddressToAddressTransport(v.Address)

	return res
}
func encodeAddressToAddressTransport(v *Address) *toolhttp.AddressTransport {
	res := &toolhttp.AddressTransport{
		Street: &v.Street,
		City:   &v.City,
	}

	return res
}

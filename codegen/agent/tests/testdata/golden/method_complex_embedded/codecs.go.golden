				Field:      issueField,
				Constraint: "unknown_field",
				Allowed:    append([]string(nil), allowed...),
			},
		},
		nil,
	)
}

// Helper transform functions
func decodeToolhttpProfileTransportToProfile(v *toolhttp.ProfileTransport) *Profile {
	res := &Profile{
		ID:   *v.ID,
		Name: v.Name,
	}
	res.Address = decodeToolhttpAddressTransportToAddress(v.Address)

	return res
}
func decodeToolhttpAddressTransportToAddress(v *toolhttp.AddressTransport) *Address {
	res := &Address{
		Street: *v.Street,
		City:   *v.City,
	}

	return res
}
func encodeProfileToToolhttpProfileTransport(v *Profile) *toolhttp.ProfileTransport {
	res := &toolhttp.ProfileTransport{
		ID:   &v.ID,
		Name: v.Name,
	}
	res.Address = encodeAddressToToolhttpAddressTransport(v.Address)

	return res
}
func encodeAddressToToolhttpAddressTransport(v *Address) *toolhttp.AddressTransport {
	res := &toolhttp.AddressTransport{
		Street: &v.Street,
		City:   &v.City,
	}

	return res
}
